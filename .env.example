# Copy this file to ".env" and fill in the values. Never commit the real .env file.

# MongoDB Atlas connection string. Put the database name (codeshelf) before the "?".
DATABASE_URL="mongodb+srv://codeshelf_user:Coolboy100@cluster0.sw6pq76.mongodb.net/codeshelf?retryWrites=true&w=majority"


# A random string used to sign login cookies. Generate one with:  npx auth secret
AUTH_SECRET="AUTH_SECRET"

# GitHub OAuth app (required). Create it at github.com/settings/developers
AUTH_GITHUB_ID="AUTH_GITHUB_ID"
AUTH_GITHUB_SECRET="AUTH_GITHUB_SECRET"

# Google OAuth (optional). The "Continue with Google" button only appears when both are filled in.
AUTH_GOOGLE_ID="AUTH_GOOGLE_ID"
AUTH_GOOGLE_SECRET="AUTH_GOOGLE_SECRET"

your_database_username="your_database_username"

your_database_password="your_database_password"